}
retline getlines(char* str, int argline) {
    retline ret;
    char *buffer = malloc(strlen(str) + 1);
    int start[strlen(str)];
    int count = 1;
    start[0] = 0;
    for (int i=0;i<strlen(str);i++) {
        if (str[i] == '\n') {
            count++;
            start[count] = i+1;
        }
    }
    int loop = 0;
    while (str[loop + start[argline]+1] != '\n' && str[loop + start[argline]+1] != '\0') {
        buffer[loop] = str[loop + start[argline]];
        loop++;
    };
    buffer[loop+1] = '\0';
    buffer[loop] = str[loop+start[argline]];
    ret.buffer = buffer;
    ret.start = start[argline];
    return ret;
}

